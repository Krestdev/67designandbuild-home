DATABASE_URL = postgres://postgres:<password>@localhost:5432/<database>
# secrecte key example: 3143547867.saveprotect
PAYLOAD_SECRET = 3143547867.saveprotect
NEXT_PUBLIC_API_URL = http://localhost:3000/api

# SMTP Email Configuration (port 465 = TLS implicite, sinon STARTTLS)
SMTP_HOST = smtp.example.com
SMTP_PORT = 465
SMTP_USER = your_smtp_username
SMTP_PASS = your_smtp_password
# Adresse d'expéditeur ; vide = SMTP_USER
EMAIL_FROM =
# Destinataire des notifications de demandes de devis
APPLICATIONS_NOTIFY_EMAIL = contact@example.com
# Lu par Docker Compose pour nommer le projet
COMPOSE_PROJECT_NAME =
